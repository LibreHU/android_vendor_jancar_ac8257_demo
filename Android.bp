// LineageOS 17.1 (branche lineage-17.1) : autochips.jar est dans PRODUCT_BOOT_JARS (device.mk de l'arbre). Android 10
// construit l'image de demarrage dans Soong (build/soong/java/dexpreopt_bootjars.go), qui ne trouve que des modules
// Soong : en module Make, « failed to find dex jar path for module "autochips" ». Module dex_import, comme
// vendor/lineage/build/tools/extract_utils.sh de LineageOS 17.1 l'ecrit pour un jar (le module Make du meme nom est
// retire d'Android.mk : un nom defini deux fois arrete le build).
dex_import {
	name: "autochips",
	owner: "jancar",
	jars: ["proprietary/framework/autochips.jar"],
}
